    buffer_box: Box<[mem::MaybeUninit<u8>]>,
    size: usize,
    node_idx: usize,
}

impl AllotedBuffer {
    fn new(buffer_box: Box<[mem::MaybeUninit<u8>]>, size: usize, node_idx: usize) -> Self {
        AllotedBuffer {
            buffer_box,
            size,
            node_idx,
        }
    }
}

